# Copie para .env.local e ajuste conforme necessário.

# true  = usa um back-end simulado no navegador (localStorage), útil enquanto a API não existe.
# false = chama a API real em /api (repassada pelo proxy do Vite).
VITE_USE_MOCK_API=true

# URL base das chamadas. Em dev mantenha /api (o proxy do Vite repassa para a API .NET).
VITE_API_BASE_URL=/api

# Endereço da API .NET usado pelo proxy do Vite em desenvolvimento.
VITE_API_PROXY_TARGET=https://localhost:7212
