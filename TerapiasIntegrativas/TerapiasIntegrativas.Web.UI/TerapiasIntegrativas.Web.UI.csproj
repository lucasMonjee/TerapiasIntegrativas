<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\..\..\Users\debor\OneDrive\Documentos\logoTipo.jpeg" Link="wwwroot\imagens\logoTipo.jpeg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
  </ItemGroup>

  <!--
    Front-end React (pasta /frontend). Ao compilar este projeto (F5 no Visual Studio),
    o React é compilado para dentro do wwwroot. Só recompila quando algo no front mudou.
  -->
  <PropertyGroup>
    <FrontendRoot>$(MSBuildProjectDirectory)\..\..\frontend\</FrontendRoot>
  </PropertyGroup>

  <ItemGroup>
    <FrontendSource Include="$(FrontendRoot)src\**\*;$(FrontendRoot)index.html;$(FrontendRoot)package.json;$(FrontendRoot)vite.config.ts;$(FrontendRoot).env*" />
  </ItemGroup>

  <Target Name="NpmInstallFrontend" BeforeTargets="BuildFrontend" Condition="!Exists('$(FrontendRoot)node_modules')">
    <Message Importance="high" Text="Instalando dependências do front-end (npm install)..." />
    <Exec Command="npm install" WorkingDirectory="$(FrontendRoot)" />
  </Target>

  <Target Name="BuildFrontend" BeforeTargets="BeforeBuild" Inputs="@(FrontendSource)" Outputs="wwwroot\index.html">
    <Message Importance="high" Text="Compilando o front-end React (npm run build)..." />
    <Exec Command="npm run build" WorkingDirectory="$(FrontendRoot)" />
  </Target>

</Project>
